{
  "expo": {
    "name": "Eureka AI",
    "slug": "eurekamobile",
    "owner": "techtune-i-t-solutions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "eurekamobile",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a8adb805-09eb-4ae7-b142-182ce3116d95"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B132B"
        }
      ],
      "expo-updates"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techtuneit.eurekamobile",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "remote-notification"],
        "NSSpeechRecognitionUsageDescription": "Eureka uses speech recognition to transcribe your voice questions to the AI Lecturer.",
        "NSMicrophoneUsageDescription": "Eureka uses your microphone to allow you to talk directly with the AI Lecturer.",
        "NSPhotoLibraryUsageDescription": "Eureka needs access to your files to allow you to select and upload PDF or text study materials.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B132B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.techtuneit.eurekamobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_DOCUMENTS",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a8adb805-09eb-4ae7-b142-182ce3116d95"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
